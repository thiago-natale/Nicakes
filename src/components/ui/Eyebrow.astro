---
/**
 * Eyebrow — o "chapéu" de toda seção: traço dourado + versal rosa-escuro.
 * `align="center"` desenha um traço de cada lado (cabeçalhos centralizados).
 * Hooks de animação: data-motion="eyebrow-line" (svg) e "eyebrow-text"
 * (scripts/motion/eyebrow.ts · heading.ts).
 */
interface Props {
  text: string;
  align?: 'start' | 'center';
  as?: 'p' | 'span' | 'div';
  /** `sage`: sobre painel sálvia sólido (texto cacau, traço creme) — contraste AA. */
  tone?: 'default' | 'sage';
  class?: string;
}
const { text, align = 'start', as: Tag = 'p', tone = 'default', class: className = '' } = Astro.props;
const center = align === 'center';
const stroke = tone === 'sage' ? 'var(--color-creme)' : 'var(--color-gold)';
---

<Tag
  data-motion="eyebrow"
  class:list={['type-eyebrow flex items-center gap-[0.6rem]', tone === 'sage' ? 'text-cocoa' : 'text-rose-darker', center && 'justify-center', className]}
>
  <svg data-motion="eyebrow-line" class="h-[2px] w-[1.6rem] shrink-0 overflow-visible" viewBox="0 0 26 2" aria-hidden="true" focusable="false">
    <line x1={center ? 26 : 0} y1="1" x2={center ? 0 : 26} y2="1" stroke={stroke} stroke-width="2"></line>
  </svg>
  <span data-motion="eyebrow-text">{text}</span>
  {
    center && (
      <svg data-motion="eyebrow-line" class="h-[2px] w-[1.6rem] shrink-0 overflow-visible" viewBox="0 0 26 2" aria-hidden="true" focusable="false">
        <line x1="0" y1="1" x2="26" y2="1" stroke={stroke} stroke-width="2" />
      </svg>
    )
  }
</Tag>
