---
/**
 * Selo numerado de etapa — círculo com contorno dourado e numeral Cormorant
 * (mesma linguagem dos numerais do "Sobre"). Decorativo: o texto da etapa vai
 * no <legend>/título; passe `label` para o leitor de tela ("Etapa 1 de 5").
 */
interface Props {
  n: number;
  label?: string;
  class?: string;
  [key: string]: unknown;
}
const { n, label, class: className = '', ...rest } = Astro.props;
---

<span class:list={['inline-grid size-[2.1rem] shrink-0 place-items-center rounded-full border border-gold bg-creme font-display text-[1.15rem] leading-none font-semibold text-gold-deep lining-nums', className]} {...rest}>
  <span aria-hidden="true">{n}</span>
  {label && <span class="sr-only">{label}</span>}
</span>
