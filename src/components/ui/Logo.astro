---
import { site } from '../../data/site';

/**
 * Logotipo oficial (PNG da marca convertido para WebP).
 * `variant="white"` usa a versão monocromática clara (rodapé: carregada sob demanda).
 */
interface Props {
  variant?: 'color' | 'white';
  class?: string;
  href?: string;
}

const { variant = 'color', class: className = 'h-[3.6rem]', href = '/' } = Astro.props;
const src = variant === 'white' ? '/brand/logo-horizontal-white.webp' : '/brand/logo-horizontal.webp';
---

<a href={href} class="inline-flex shrink-0 rounded-md" aria-label={`${site.fullName} — página inicial`}>
  <img src={src} alt={site.fullName} width="344" height="200" class:list={['w-auto', className]} decoding="async" loading={variant === 'white' ? 'lazy' : undefined} />
</a>
