---
/**
 * Cabeçalho da página /encomendas — mesma linguagem do Cardápio e da 404:
 * eyebrow dourado, título com destaque em itálico rosa e floreio, lead e os
 * passos do pedido (âncoras para cada etapa). No desktop, a foto do bolo
 * aparece com a gota que cresce (como nas Encomendas da home).
 */
import Eyebrow from '../../ui/Eyebrow.astro';
import Swash from '../../ui/Swash.astro';
import { srcsetOf } from '../../../data/images';
import { orderHeaderCopy as copy } from './orderHeader';
import './orderHeader.css';

const photo = '/images/custom-birthday-cake.webp';
---

<section
  class="order-header content-x relative z-10 pt-[calc(var(--header-height)+2.25rem)] pb-[1.5rem] lg:pt-[calc(var(--header-height)+2.6rem)] lg:pb-[2rem]"
  data-motion-section="order-header"
  aria-labelledby="order-title"
>
  <div class="grid items-center gap-[2rem] lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-[clamp(2rem,5vw,6rem)]">
    <div data-motion-hero>
      <Eyebrow text={copy.eyebrow} />
      <h1 id="order-title" class="type-section mt-[0.8rem] text-cocoa lg:text-[3rem]">
        <span class="block" data-motion="oh-line">{copy.title}</span>
        <span class="order-header__accent-wrap relative inline-block">
          <em class="block font-medium text-rose-deep italic" data-motion="oh-accent">{copy.accent}</em>
          <Swash class="order-header__swash" data-motion="oh-swash" />
        </span>
      </h1>
      <p class="type-body mt-[1.6rem] max-w-[30rem] text-cocoa-soft" data-motion="oh-lead">{copy.lead}</p>

      <nav class="mt-[1.4rem]" aria-label={copy.stepsLabel}>
        <ol class="flex flex-wrap gap-[0.5rem]">
          {
            copy.steps.map((step, i) => (
              <li data-motion="oh-step">
                <a
                  href={`#${step.id}`}
                  class="inline-flex h-[2.75rem] items-center gap-[0.5rem] rounded-full border border-line bg-white/80 pr-[1rem] pl-[0.4rem] text-[0.75rem] font-medium text-cocoa transition-colors hover:border-rose hover:bg-blush lg:h-[2.4rem]"
                >
                  <span class="inline-grid size-[1.6rem] place-items-center rounded-full border border-gold/70 bg-creme font-display text-[0.9rem] leading-none font-semibold text-gold-deep lining-nums" aria-hidden="true">
                    {i + 1}
                  </span>
                  {step.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>

    <div class="order-header__media hidden lg:block" data-motion-hero aria-hidden="true">
      <img
        data-motion="oh-image"
        src={photo}
        srcset={srcsetOf(photo, 1100)}
        sizes="40vw"
        alt=""
        width="1100"
        height="614"
        loading="lazy"
        decoding="async"
        class="order-header__photo"
      />
    </div>
  </div>

  <svg class="absolute size-0" aria-hidden="true" focusable="false">
    <defs>
      <path id="oh-clip-seed" d="M0.5 0.3 C0.62 0.3 0.7 0.42 0.7 0.52 C0.7 0.64 0.6 0.72 0.5 0.72 C0.4 0.72 0.3 0.64 0.3 0.52 C0.3 0.42 0.38 0.3 0.5 0.3 Z"></path>
    </defs>
    <clipPath id="oh-clip" clipPathUnits="objectBoundingBox">
      <path data-motion="oh-clip" d="M0 0 H1 V1 H0 Z"></path>
    </clipPath>
  </svg>
</section>
