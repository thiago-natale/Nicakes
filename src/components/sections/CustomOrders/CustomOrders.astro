---
/**
 * Encomendas (home) — um cabeçalho e dois painéis: bolo de aniversário (texto |
 * foto) e docinhos para festa (foto | texto), cada um com slider, máscara,
 * ornamento e passos próprios. Embaixo, o atalho para montar os dois num pedido
 * só. Dados: customOrders.ts.
 *
 * Desktop com altura suficiente (`STACKED_QUERY`): o "palco" ocupa a tela abaixo
 * do header e os painéis dividem a altura (bolo em cima, docinhos embaixo). A
 * montagem é feita pela rolagem, com o palco fixo (pin) — customOrders.motion.ts.
 */
import SectionHeading from '../../ui/SectionHeading.astro';
import Icon from '../../ui/Icon.astro';
import OrderPanel from './OrderPanel.astro';
import { bothLink, orderPanels, ordersSectionLead } from './customOrders';
import './customOrders.css';
---

<section
  id="encomendas"
  data-motion-section="custom-orders"
  class="custom-orders section-x section-y relative scroll-mt-6 overflow-x-clip"
  aria-labelledby="orders-title"
>
  <SectionHeading
    id="orders-title"
    eyebrow="Encomendas"
    title="Bolos e docinhos"
    accent="sob encomenda."
    lead={ordersSectionLead}
    leadClass="max-w-[30rem]"
    class="relative z-10 panel-x"
  />

  <div class="custom-orders__stage relative z-10 mt-[1.6rem] grid gap-[1.25rem] lg:mt-[2rem] lg:gap-[1.75rem]" data-motion="co-stage">
    {orderPanels.map((panel) => <OrderPanel panel={panel} />)}
  </div>

  <p class="relative z-10 mt-[1.4rem] text-center" data-motion="co-both">
    <a href={bothLink.href} class="text-link inline-flex min-h-[2.75rem] items-center gap-[0.4rem] text-[0.8rem] font-medium">
      {bothLink.label}
      <Icon name="arrow" class="size-[0.9rem]" />
    </a>
  </p>
</section>
