---
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import SectionHeading from '../../ui/SectionHeading.astro';
import { orderPerks, ordersImage } from './customOrders';
import { srcsetOf } from '../../../data/images';
import './customOrders.css';
---

<section id="encomendas" data-motion-section="custom-orders" class="custom-orders section-x section-y relative scroll-mt-6" aria-labelledby="orders-title">
  <div data-motion="co-panel" class="relative z-10 grid overflow-hidden rounded-panel bg-blush shadow-panel md:grid-cols-[minmax(0,1fr)_minmax(0,19rem)] lg:min-h-[clamp(13rem,16vw,19rem)] lg:grid-cols-[minmax(0,1fr)_minmax(22.95rem,46%)]">
    <div class="panel-x panel-y lg:self-center">
      <SectionHeading
        id="orders-title"
        eyebrow="Encomendas"
        title="Bolos de aniversário"
        accent="sob encomenda."
        lead="Escolha a massa, o recheio e os detalhes da decoração. A gente cuida do resto para a sua comemoração ficar ainda mais doce."
        leadClass="max-w-[30rem]"
      />

      <div class="mt-[1.1rem] flex flex-col gap-[0.6rem] sm:flex-row sm:items-start sm:gap-[1.6rem] md:flex-col md:gap-[0.6rem] lg:mt-[0.9rem] lg:flex-row lg:gap-[1.6rem]">
        <Button href="/encomendas" iconEnd="arrow" class="self-start sm:mt-[1.95rem] md:mt-0 lg:mt-[1.95rem]" data-motion="co-cta">
          Montar meu bolo
        </Button>

        <!-- pt reserva o espaço do caminho pontilhado (que passa acima dos ícones) -->
        <ul class="relative flex pt-[1.9rem]" aria-label="Como funciona a encomenda" data-motion="co-perks">
          <!-- Caminho entre os passos (gerado em JS) e coração que o percorre (MotionPath) -->
          <svg class="pointer-events-none absolute inset-0 size-full overflow-visible" data-motion="co-path" aria-hidden="true" focusable="false">
            <defs>
              <mask id="co-path-mask" maskUnits="userSpaceOnUse" x="-50" y="-80" width="2000" height="400">
                <path data-motion="co-path-reveal" d="" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round"></path>
              </mask>
            </defs>
            <path data-motion="co-path-line" d="" fill="none" stroke="var(--color-rose)" stroke-opacity="0.75" stroke-width="1.3" stroke-dasharray="2 5" stroke-linecap="round" mask="url(#co-path-mask)"></path>
          </svg>
          <Icon name="heart-solid" class="pointer-events-none absolute top-0 left-0 z-10 hidden size-[0.85rem] text-gold" data-motion="co-heart" />
          {
            orderPerks.map((perk) => (
              <li class="relative flex w-[6.2rem] flex-col items-center text-center" data-motion="co-perk">
                <span class="icon-circle size-[2.6rem] bg-white/70" data-motion="co-perk-icon">
                  <Icon name={perk.icon} class="size-[1.45rem]" strokeWidth={1.4} />
                </span>
                <span class="type-small mt-[0.4rem] text-cocoa-soft" style="line-height:1.3" data-motion="co-perk-text">
                  {perk.lines[0]}
                  <br />
                  {perk.lines[1]}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="custom-orders__media relative" data-motion="co-media">
      <img
        data-motion="co-image"
        src={ordersImage.src}
        srcset={srcsetOf(ordersImage.src, ordersImage.width)}
        sizes="(max-width: 767px) 100vw, 46vw"
        alt={ordersImage.alt}
        width={ordersImage.width}
        height={ordersImage.height}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>
  </div>

  <!-- Recorte orgânico da foto: cresce de uma gota até o retângulo (MorphSVG) -->
  <svg class="absolute size-0" aria-hidden="true" focusable="false">
    <defs>
      <path id="co-clip-seed" d="M0.5 0.3 C0.62 0.3 0.7 0.42 0.7 0.52 C0.7 0.64 0.6 0.72 0.5 0.72 C0.4 0.72 0.3 0.64 0.3 0.52 C0.3 0.42 0.38 0.3 0.5 0.3 Z"></path>
    </defs>
    <clipPath id="co-clip" clipPathUnits="objectBoundingBox">
      <path data-motion="co-clip" d="M0 0 H1 V1 H0 Z"></path>
    </clipPath>
  </svg>
</section>
