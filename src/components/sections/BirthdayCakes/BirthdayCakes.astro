---
import Button from '../../ui/Button.astro';
import MenuList from '../../ui/MenuList.astro';
import SectionDivider from '../../ui/SectionDivider.astro';
import { birthdayCake, formatPrice } from '../../../data/menu';
import { whatsappLink } from '../../../data/site';

const message = 'Olá! Gostaria de encomendar um bolo de aniversário na Nicake’s.';
---

<section id="bolos" data-motion-section="birthday-cakes" class="section-x relative z-10 scroll-mt-6 pt-[1.75rem] pb-[2rem] lg:pb-[2.5rem]" aria-labelledby="bolos-title">
  <SectionDivider id="bolos-title">Bolos de aniversário</SectionDivider>

  <div data-motion="bc-panel" class="mt-[1rem] grid overflow-hidden rounded-panel bg-blush shadow-panel md:grid-cols-[minmax(0,1fr)_minmax(0,20rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,42%)]">
    <div class="px-[1.5rem] py-[1.6rem] lg:px-[2rem]">
      <p class="font-display text-[1.6rem] leading-none font-semibold text-cocoa">
        <span class="sr-only">{formatPrice(birthdayCake.price)}</span>
        <span aria-hidden="true" class="tabular-nums" data-motion="bc-price" data-price={birthdayCake.price}>{formatPrice(birthdayCake.price)}</span>
        <span class="font-sans text-[0.7rem] font-normal text-cocoa-soft">· sob encomenda</span>
      </p>

      <h3 class="mt-[1.2rem] text-[0.62rem] font-medium tracking-[0.18em] text-rose-darker uppercase">Massas</h3>
      <p class="mt-[0.35rem] text-[0.8rem] text-cocoa">{birthdayCake.doughs.join(' · ')}</p>

      <h3 class="mt-[1rem] text-[0.62rem] font-medium tracking-[0.18em] text-rose-darker uppercase">Recheios</h3>
      <ul class="mt-[0.45rem] flex flex-wrap gap-[0.4rem]">
        {birthdayCake.fillings.map((f) => <li data-motion="bc-chip" class="rounded-full bg-white/80 px-[0.7rem] py-[0.25rem] text-[0.7rem] text-cocoa">{f}</li>)}
      </ul>

      <h3 class="mt-[1rem] mb-[0.5rem] text-[0.62rem] font-medium tracking-[0.18em] text-rose-darker uppercase">Adicionais</h3>
      <div data-motion="bc-extras"><MenuList items={birthdayCake.extras} class="max-w-[22rem]" /></div>

      <Button href={whatsappLink(message)} variant="sage" icon="whatsapp" class="mt-[1.4rem]" data-motion="bc-cta">
        Encomendar pelo WhatsApp
      </Button>
    </div>
    <img
      data-motion="bc-image"
      src="/images/custom-birthday-cake.webp"
      alt="Bolo de aniversário de dois andares em tons de rosa, decorado com rosas"
      width="1100"
      height="614"
      loading="lazy"
      decoding="async"
      class="h-full max-h-[22rem] w-full object-cover object-[62%_50%] md:max-h-none"
    />
  </div>

  <svg class="absolute size-0" aria-hidden="true" focusable="false">
    <defs>
      <path id="bc-clip-seed" d="M0.5 0.3 C0.62 0.3 0.7 0.42 0.7 0.52 C0.7 0.64 0.6 0.72 0.5 0.72 C0.4 0.72 0.3 0.64 0.3 0.52 C0.3 0.42 0.38 0.3 0.5 0.3 Z"></path>
    </defs>
    <clipPath id="bc-clip" clipPathUnits="objectBoundingBox">
      <path data-motion="bc-clip" d="M0 0 H1 V1 H0 Z"></path>
    </clipPath>
  </svg>
</section>
