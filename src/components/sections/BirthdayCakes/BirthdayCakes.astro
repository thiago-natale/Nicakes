---
import Button from '../../ui/Button.astro';
import CakeSlider from '../../ui/CakeSlider.astro';
import MenuList from '../../ui/MenuList.astro';
import SectionDivider from '../../ui/SectionDivider.astro';
import { birthdayCake, cakePriceFrom, formatPrice, formatKg } from '../../../data/menu';

const priceFrom = cakePriceFrom();
const yields = birthdayCake.sizes.filter((s) => s.kg <= 2).map((s) => `${formatKg(s.kg)}: ${s.serves}`);
---

<section id="bolos" data-motion-section="birthday-cakes" class="section-x relative z-10 scroll-mt-6 pt-[1.75rem] pb-[2rem] lg:pb-[2.5rem]" aria-labelledby="bolos-title">
  <SectionDivider id="bolos-title">Bolos de aniversário</SectionDivider>

  <div data-motion="bc-panel" class="mt-[1rem] grid overflow-hidden rounded-panel bg-blush shadow-panel xl:grid-cols-[minmax(0,1fr)_minmax(0,42%)]">
    <div class="px-[1.5rem] py-[1.6rem] lg:px-[2rem]">
      <p class="font-display text-[1.6rem] leading-none font-semibold text-cocoa">
        <span class="sr-only">A partir de {formatPrice(priceFrom)} o quilo</span>
        <span class="mr-[0.35em] font-sans text-[0.7rem] font-normal text-cocoa-soft" aria-hidden="true">a partir de</span>
        <span aria-hidden="true" class="tabular-nums" data-motion="bc-price" data-price={priceFrom}>{formatPrice(priceFrom)}</span>
        <span class="ml-[0.2em] font-sans text-[0.7rem] font-normal text-cocoa-soft" aria-hidden="true">/ kg</span>
        <span class="ml-[0.3em] font-sans text-[0.7rem] font-normal text-cocoa-soft">· sob encomenda</span>
      </p>

      <p class="mt-[0.5rem] type-small text-cocoa-soft">Rendimento — {yields.join(' · ')} · acima de 2 kg, cerca de 10 pessoas por kg.</p>

      <h3 class="mt-[1.2rem] text-[0.62rem] font-medium tracking-[0.18em] text-rose-darker uppercase">Decoração <span class="font-normal tracking-normal normal-case text-cocoa-soft">· preço por kg</span></h3>
      <p class="mt-[0.35rem] text-[0.8rem] text-cocoa">
        {birthdayCake.decorations.map((d, i) => (
          <>
            {i > 0 && ' · '}
            {d.name} <span class="text-rose-darker tabular-nums">{formatPrice(d.pricePerKg)}</span>
          </>
        ))}
      </p>

      <h3 class="mt-[1rem] text-[0.62rem] font-medium tracking-[0.18em] text-rose-darker uppercase">Massas</h3>
      <p class="mt-[0.35rem] text-[0.8rem] text-cocoa">{birthdayCake.doughs.join(' · ')}</p>

      <h3 class="mt-[1rem] text-[0.62rem] font-medium tracking-[0.18em] text-rose-darker uppercase">Recheios <span class="font-normal tracking-normal normal-case text-cocoa-soft">· até {birthdayCake.rules.maxFillings} por bolo</span></h3>
      <ul class="mt-[0.45rem] flex flex-wrap gap-[0.4rem]">
        {birthdayCake.fillings.map((f) => (
          <li data-motion="bc-chip" class="rounded-full bg-white/80 px-[0.7rem] py-[0.25rem] text-[0.7rem] text-cocoa">
            {f.name}
            {f.price && <span class="text-rose-darker"> +{formatPrice(f.price)}</span>}
          </li>
        ))}
      </ul>

      <h3 class="mt-[1rem] mb-[0.5rem] text-[0.62rem] font-medium tracking-[0.18em] text-rose-darker uppercase">Adicionais</h3>
      <div data-motion="bc-extras"><MenuList items={birthdayCake.extras} class="max-w-[22rem]" /></div>

      <Button href="/encomendas" iconEnd="arrow" class="mt-[1.4rem]" data-motion="bc-cta">
        Montar meu bolo
      </Button>
    </div>
    <!-- Empilhado (16:9) até 1280px; ao lado do texto a partir daí -->
    <div class="relative aspect-video xl:aspect-auto">
      <CakeSlider sizes="(max-width: 1279px) 100vw, 42vw" motion="bc-image" awaitIntro class="absolute inset-0" />
    </div>
  </div>

  <svg class="absolute size-0" aria-hidden="true" focusable="false">
    <defs>
      <path id="bc-clip-seed" d="M0.5 0.3 C0.62 0.3 0.7 0.42 0.7 0.52 C0.7 0.64 0.6 0.72 0.5 0.72 C0.4 0.72 0.3 0.64 0.3 0.52 C0.3 0.42 0.38 0.3 0.5 0.3 Z"></path>
    </defs>
    <clipPath id="bc-clip" clipPathUnits="objectBoundingBox">
      <path data-motion="bc-clip" d="M0 0 H1 V1 H0 Z"></path>
    </clipPath>
  </svg>
</section>
