---
/**
 * PartySweets (/cardapio#docinhos) — docinhos de festa sob encomenda, no mesmo
 * formato de "Bolos de aniversário", espelhado: slider à esquerda (a partir de
 * 1280px; em cima, em 16:9, abaixo disso), tipos com preço do cento, sabores em
 * chips, personalizados e extras "a combinar" e as regras do pedido.
 * Dados: partySweets (data/menu.ts). Animação: partySweets.motion.ts.
 */
import Button from '../../ui/Button.astro';
import CakeSlider from '../../ui/CakeSlider.astro';
import SectionDivider from '../../ui/SectionDivider.astro';
import { formatPrice, partySweets, sweetsPriceFrom } from '../../../data/menu';
import { MASK_FULL, MASK_SEEDS } from '../../../scripts/motion/masks';
import { sweetsRules } from './partySweets';

const priceFrom = sweetsPriceFrom();
---

<section id="docinhos" data-motion-section="party-sweets" class="section-x relative z-10 scroll-mt-6 overflow-x-clip pt-[1.75rem] pb-[2rem] lg:pb-[2.5rem]" aria-labelledby="docinhos-title">
  <SectionDivider id="docinhos-title">Docinhos de festa</SectionDivider>

  <div data-motion="ps-panel" class="mt-[1rem] grid overflow-hidden rounded-panel bg-blush shadow-panel xl:grid-cols-[minmax(0,42%)_minmax(0,1fr)]">
    <!-- Em cima (16:9) até 1280px; ao lado do texto, à esquerda, a partir daí -->
    <div class="relative aspect-video xl:aspect-auto">
      <CakeSlider sizes="(max-width: 1279px) 100vw, 42vw" motion="ps-image" awaitIntro kinds={['sweets']} class="absolute inset-0" />
    </div>

    <div class="px-[1.5rem] py-[1.6rem] lg:px-[2rem]">
      <p class="font-display text-[1.6rem] leading-none font-semibold text-cocoa">
        <span class="sr-only">A partir de {formatPrice(priceFrom)} o cento</span>
        <span class="mr-[0.35em] font-sans text-[0.7rem] font-normal text-cocoa-soft" aria-hidden="true">a partir de</span>
        <span aria-hidden="true" class="tabular-nums" data-motion="ps-price">{formatPrice(priceFrom)}</span>
        <span class="ml-[0.2em] font-sans text-[0.7rem] font-normal text-cocoa-soft" aria-hidden="true">/ cento</span>
        <span class="ml-[0.3em] font-sans text-[0.7rem] font-normal text-cocoa-soft">· sob encomenda</span>
      </p>

      <p class="mt-[0.5rem] type-small text-cocoa-soft">{sweetsRules}</p>

      <div class="mt-[1.1rem] grid gap-[1rem]">
        {
          partySweets.categories.map((c) => (
            <div data-motion="ps-type">
              <div class="flex items-baseline gap-2 text-cocoa">
                <h3 class="min-w-0 text-[0.62rem] font-medium tracking-[0.18em] text-rose-darker uppercase">
                  {c.name} <span class="font-normal tracking-normal normal-case text-cocoa-soft">· {c.weight}</span>
                </h3>
                <span class="menu-list__leader min-w-[1rem] flex-1 self-end" aria-hidden="true" />
                <span class="shrink-0 text-[0.78rem] font-medium whitespace-nowrap tabular-nums">
                  {formatPrice(c.pricePerHundred)} <span class="text-[0.65rem] font-normal text-cocoa-soft">o cento</span>
                </span>
              </div>
              <ul class="mt-[0.45rem] flex flex-wrap gap-[0.4rem]" aria-label={`Sabores de ${c.name.toLowerCase()}`}>
                {c.flavors.map((f) => (
                  <li data-motion="ps-chip" class="rounded-full bg-white/80 px-[0.7rem] py-[0.25rem] text-[0.7rem] text-cocoa">
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <ul class="space-y-[0.45rem]" data-motion="ps-custom">
          <li class="flex items-baseline gap-2 text-[0.78rem] leading-[1.25] text-cocoa">
            <span class="min-w-0">
              {partySweets.custom.name}
              <span class="block text-[0.65rem] text-cocoa-soft">Decorados com o tema, as cores e os detalhes da festa</span>
            </span>
            <span class="menu-list__leader min-w-[1rem] flex-1 self-end" aria-hidden="true" />
            <span class="shrink-0 text-[0.7rem] text-rose-darker italic">valor a combinar</span>
          </li>
          {
            partySweets.extras.map((e) => (
              <li class="flex items-baseline gap-2 text-[0.78rem] leading-[1.25] text-cocoa">
                <span class="min-w-0">
                  {e.name}
                  {e.hint && <span class="block text-[0.65rem] text-cocoa-soft">{e.hint}</span>}
                </span>
                <span class="menu-list__leader min-w-[1rem] flex-1 self-end" aria-hidden="true" />
                <span class="shrink-0 text-[0.7rem] text-rose-darker italic">valor a combinar</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-[1.4rem] flex flex-wrap items-center gap-x-[1.25rem] gap-y-[0.5rem]">
        <Button href="/encomendas?pedido=docinhos" iconEnd="arrow" data-motion="ps-cta">Escolher meus docinhos</Button>
        <a href="/encomendas?pedido=bolo,docinhos" class="text-link inline-flex min-h-[2.75rem] items-center text-[0.75rem] font-medium" data-motion="ps-both">
          Vai querer o bolo também? Monte os dois
        </a>
      </div>
    </div>
  </div>

  <svg class="absolute size-0" aria-hidden="true" focusable="false">
    <defs>
      <path id="ps-clip-seed" d={MASK_SEEDS.cup}></path>
    </defs>
    <clipPath id="ps-clip" clipPathUnits="objectBoundingBox">
      <path data-motion="ps-clip" d={MASK_FULL}></path>
    </clipPath>
  </svg>
</section>
