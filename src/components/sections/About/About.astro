---
/**
 * "A Nicake’s" (#sobre) — o capítulo da marca, segundo ato depois do hero.
 * Manifesto que se "escreve" com o scroll → colagem de bastidores em recortes
 * orgânicos com o selo → história + três promessas ligadas pelo fio dourado →
 * números da casa. Plano: claude/plano-secao-sobre.md.
 */
import BrandSeal from '../../ui/BrandSeal.astro';
import Icon from '../../ui/Icon.astro';
import Swash from '../../ui/Swash.astro';
import Button from '../../ui/Button.astro';
import Eyebrow from '../../ui/Eyebrow.astro';
import { manifesto, story, promises, stats, collage } from './about';
import { srcsetOf } from '../../../data/images';
import './about.css';
---

<section id="sobre" data-motion-section="about" class="about content-x relative z-10 scroll-mt-6 pt-[3rem] lg:pt-[4.2rem]" aria-labelledby="about-title">
  <!-- Manifesto -->
  <div class="max-w-[56rem]">
    <Eyebrow text="A Nicake’s" />
    <h2 id="about-title" data-motion="about-manifesto" class="mt-[0.9rem] font-display text-[1.85rem] leading-[1.2] font-medium text-cocoa sm:text-[2.2rem] lg:text-[2.6rem] lg:leading-[1.14]">
      {
        manifesto.map((seg) =>
          seg.swash ? (
            <span class="about__swash-word text-rose-deep italic">
              {seg.text}
              <Swash class="about__swash" data-motion="about-swash" />
            </span>
          ) : seg.accent ? (
            <em class="text-rose-deep italic">{seg.text}</em>
          ) : (
            seg.text
          ),
        )
      }
    </h2>
  </div>

  <div class="mt-[2.4rem] grid gap-[2.6rem] lg:mt-[3rem] lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-[clamp(2.5rem,5vw,6rem)]">
    <!-- Colagem de bastidores -->
    <div class="about__collage relative mx-auto w-full max-w-[26rem] lg:max-w-none" data-motion="about-collage">
      <svg class="about__blob" viewBox="0 0 400 400" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <defs>
          <path id="about-blob-seed" d="M60 170 C80 150 110 160 116 190 C122 222 96 240 70 232 C44 224 40 190 60 170 Z"></path>
        </defs>
        <path data-motion="about-blob" fill="var(--color-sage-mist)" d="M70 40 C150 -6 300 10 360 90 C414 162 392 280 318 340 C244 400 110 404 50 336 C-6 272 -10 86 70 40 Z"></path>
      </svg>

      <div class="about__photo about__photo--main" data-motion="about-photo" data-clip="#about-clip-main">
        <img src={collage.main.src} srcset={srcsetOf(collage.main.src, collage.main.width)} sizes="(max-width: 899px) 66vw, 30vw" alt={collage.main.alt} width={collage.main.width} height={collage.main.height} loading="lazy" decoding="async" class="size-full object-cover" style={`object-position: ${collage.main.position}`} />
      </div>
      <div class="about__photo about__photo--detail" data-motion="about-photo" data-clip="#about-clip-detail">
        <img src={collage.detail.src} srcset={srcsetOf(collage.detail.src, collage.detail.width)} sizes="(max-width: 899px) 38vw, 18vw" alt={collage.detail.alt} width={collage.detail.width} height={collage.detail.height} loading="lazy" decoding="async" class="size-full object-cover" style={`object-position: ${collage.detail.position}`} />
      </div>
      <div class="about__seal" data-motion="about-seal">
        <BrandSeal class="relative size-full" />
      </div>

      <svg class="absolute size-0" aria-hidden="true" focusable="false">
        <defs>
          <path id="about-clip-main-seed" d="M0.48 0.4 C0.58 0.38 0.64 0.46 0.62 0.54 C0.6 0.62 0.52 0.64 0.45 0.6 C0.38 0.56 0.38 0.42 0.48 0.4 Z"></path>
          <path id="about-clip-detail-seed" d="M0.5 0.38 C0.6 0.38 0.64 0.46 0.62 0.54 C0.6 0.62 0.52 0.64 0.46 0.6 C0.4 0.56 0.4 0.4 0.5 0.38 Z"></path>
        </defs>
        <clipPath id="about-clip-main" clipPathUnits="objectBoundingBox">
          <path d="M0.08 0 L0.86 0 C0.95 0 0.985 0.06 0.965 0.16 C0.935 0.32 0.905 0.5 0.945 0.68 C0.985 0.86 0.965 1 0.86 1 L0.08 1 Q0 1 0 0.93 L0 0.07 Q0 0 0.08 0 Z"></path>
        </clipPath>
        <clipPath id="about-clip-detail" clipPathUnits="objectBoundingBox">
          <path d="M0.52 0.03 C0.8 0.05 0.97 0.24 0.96 0.52 C0.95 0.8 0.76 0.97 0.48 0.96 C0.2 0.95 0.03 0.77 0.04 0.49 C0.05 0.22 0.25 0.01 0.52 0.03 Z"></path>
        </clipPath>
      </svg>
    </div>

    <!-- História + promessas -->
    <div>
      <p data-motion="about-story" class="type-body max-w-[34rem] text-cocoa-soft">{story}</p>

      <ol class="about__promises relative mt-[1.8rem]" data-motion="about-promises" aria-label="Nossas promessas">
        {
          promises.map((item, i) => (
            <li class="about__promise relative grid grid-cols-[3rem_minmax(0,1fr)] gap-x-[1rem] pb-[1.6rem] last:pb-0" data-motion="about-promise">
              <span class="about__numeral font-display text-[2.1rem] font-semibold lining-nums" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {
                i < promises.length - 1 && (
                  <span class="about__link" aria-hidden="true">
                    <span class="about__link-line" data-motion="about-link-line" />
                    <span class="about__link-dot" data-motion="about-link-dot" />
                  </span>
                )
              }
              <div class="about__promise-body">
                <div class="flex items-center gap-[0.55rem]">
                  <Icon name={item.icon} class="size-[1.35rem] shrink-0 text-sage-deep" strokeWidth={1.3} data-motion="about-promise-icon" />
                  <h3 class="font-display text-card font-semibold text-cocoa" data-motion="about-promise-title">{item.title}</h3>
                </div>
                <p class="type-small mt-[0.3rem] max-w-[30rem] text-cocoa-soft" data-motion="about-promise-text">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <!-- Números da casa -->
  <div class="relative mt-[2.4rem] flex flex-col gap-[1.4rem] pt-[1.6rem] lg:mt-[3rem] lg:flex-row lg:items-center lg:justify-between" data-motion="about-stats">
    <span class="about__rule" data-motion="about-rule" aria-hidden="true"></span>
    <ul class="grid grid-cols-3 gap-[0.6rem] lg:flex lg:gap-0" aria-label="Números da casa">
      {
        stats.map((stat) => (
          <li class="about__stat text-center lg:px-[2.4rem] lg:text-left lg:first:pl-0" data-motion="about-stat">
            <span class="sr-only">{stat.sr}</span>
            <span class="block overflow-hidden" aria-hidden="true">
              <span class="block font-display text-[2rem] leading-none font-semibold text-cocoa lining-nums lg:text-[2.4rem]" data-motion="about-stat-value">
                {stat.value}
              </span>
            </span>
            <span class="mt-[0.3rem] block text-[0.6rem] leading-[0.85rem] tracking-[0.12em] text-cocoa-soft uppercase" aria-hidden="true" data-motion="about-stat-label">
              {stat.label}
            </span>
          </li>
        ))
      }
    </ul>
    <div class="self-center lg:self-auto" data-motion="about-link">
      <Button href="/cardapio" variant="outline" iconEnd="arrow">Conheça nosso cardápio</Button>
    </div>
  </div>
</section>
