---
import SiteLayout from '@/layouts/SiteLayout.astro';
import LegalContent from '@/components/sections/LegalContent/LegalContent.astro';
import { brand } from '@/data/brand';
import { phone, whatsappUrl } from '@/data/contact';
import { legal } from '@/data/legal';
import { address } from '@/data/location';
---

<!-- Texto-base: revisar com a Nicake's antes de publicar. -->
<SiteLayout page="termos">
  <LegalContent title="Termos de uso" updated="novembro de 2026" page="termos">
    <p>
      As informações deste site — produtos, preços e horários — têm caráter informativo e podem mudar sem aviso prévio. A
      confirmação de preço, disponibilidade e prazo acontece no atendimento pela loja, pelo WhatsApp ou pelo iFood.
    </p>
    <h2>Encomendas</h2>
    <p>
      Encomendas de bolos e doces são combinadas diretamente com a {brand.fullName} pelo WhatsApp
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{phone.display}</a>, incluindo sabores, data de
      retirada e forma de pagamento.
    </p>
    <h2>Imagens</h2>
    <p>As fotos do site são ilustrativas; a apresentação dos produtos pode variar.</p>
    <h2>Responsável</h2>
    <p>
      {brand.fullName} — CNPJ {legal.cnpj}. {address.street}, {address.district}, {address.city} –
      {address.state}, CEP {address.postalCode}. Atendimento pelo WhatsApp
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{phone.display}</a>.
    </p>
  </LegalContent>
</SiteLayout>
