# Copie para .env e preencha só o que for usar. Nada aqui é secreto:
# as variáveis PUBLIC_* vão para o HTML publicado.

# URL do site (sem barra no fim). Padrão: domínio oficial em site.config.mjs.
# Use para testar um preview da Vercel, por exemplo.
# SITE_URL=https://www.nicakesconfeitaria.com.br

# Verificação de propriedade (Search Console e Bing Webmaster Tools)
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 (ex.: G-XXXXXXXXXX). Vazio = sem analytics.
# Antes de ativar: aviso de cookies e atualização da Política de privacidade.
PUBLIC_GA4_ID=
